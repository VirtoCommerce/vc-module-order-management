<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>1591</NoWarn>
    <IsPackable>False</IsPackable>
    <OutputType>Library</OutputType>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="dist\**" />
    <Compile Remove="node_modules\**" />
    <Content Remove="dist\**" />
    <EmbeddedResource Remove="dist\**" />
    <EmbeddedResource Remove="node_modules\**" />
    <None Remove="dist\**" />
    <None Remove="node_modules\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="VirtoCommerce.CatalogModule.Core" Version="3.1000.0" />
    <PackageReference Include="VirtoCommerce.OrdersModule.Data" Version="3.1000.0" />
    <PackageReference Include="VirtoCommerce.StoreModule.Core" Version="3.1000.0" />
    <PackageReference Include="VirtoCommerce.XCatalog.Core" Version="3.1000.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.OrderManagement.Core\VirtoCommerce.OrderManagement.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.OrderManagement.Data\VirtoCommerce.OrderManagement.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.OrderManagement.ExperienceApi\VirtoCommerce.OrderManagement.ExperienceApi.csproj" />
  </ItemGroup>
  <!-- Admin Shell module UI: Vue sources in vue/, built into plugins/admin-shell/ -->
  <ItemGroup>
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <!-- Admin Shell plugin: built from vue/ into plugins/admin-shell/ before publish, so vc-build Compress (locally and in CI)
       packs it, as VirtoCommerce.SalesRep builds its storefront plugin. SkipAdminShellPlugin=true leaves it out. -->
  <Target Name="BuildAdminShellPlugin" BeforeTargets="Publish" Condition="'$(SkipAdminShellPlugin)' != 'true' AND Exists('$(MSBuildProjectDirectory)\vue\package.json')">
    <Exec Command="corepack enable" ContinueOnError="true" />
    <Exec Command="yarn install --immutable" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
    <Exec Command="yarn type-check" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
    <Exec Command="yarn build" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
  </Target>
  <!-- The platform probes {moduleRoot}/plugins/, but publish goes to {moduleRoot}/bin. The files are listed here, after the
       build: listed when the project loads, a clean checkout (no plugins/ yet) would copy nothing. -->
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish" DependsOnTargets="BuildAdminShellPlugin" Condition="'$(SkipAdminShellPlugin)' != 'true'">
    <ItemGroup>
      <AdminShellPlugin Include="$(MSBuildProjectDirectory)\plugins\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\plugins\%(RecursiveDir)%(Filename)%(Extension)" />
  </Target>
</Project>
